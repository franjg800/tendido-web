# Tendido web: tipos y caché para servidores Apache
AddType application/wasm .wasm
AddType application/manifest+json .webmanifest
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/wasm application/javascript text/html application/json
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(wasm|png|jpg|webp|ttf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "^(index\.html|tendido\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
